{
    "name": "ts-starter",
    "version": "1.0.0",
    "description": "A minimal Node.js and TypeScript project template.",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "typecheck": "tsc --noEmit",
        "build": "tsc",
        "clean": "rimraf dist",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "start": "node dist/index.js",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/akshat-jjain/node-ts-starter.git"
    },
    "keywords": [
        "node",
        "typescript",
        "template"
    ],
    "author": "Akshat Jain",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "bugs": {
        "url": "https://github.com/akshat-jjain/node-ts-starter/issues"
    },
    "homepage": "https://github.com/akshat-jjain/node-ts-starter/#readme",
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": "prettier --write"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.2.0",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.15",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.65.0"
    },
    "dependencies": {
        "dotenv": "^17.4.2"
    }
}
