# Local API server port (Render provides PORT automatically)
PORT=3000
# development | production | test
NODE_ENV=development
# stub | groq (stub is deterministic and requires no credentials)
AI_PROVIDER=stub
# Server-only Groq configuration; never add these values to Vite variables.
# Set AI_PROVIDER=groq and provide a key to use the open-weight model.
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=15000
